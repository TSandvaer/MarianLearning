{
  /* Core's unit tests. They run under the root Vitest config (jsdom +
   * src/test/setup.ts, which installs the web platform), so they are
   * type-checked with the same lib/types as the web app's tests. The
   * no-DOM guard applies to core's sources (tsconfig.json), not to its
   * tests. */
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.core-test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts"]
}
