coverage

# Playwright e2e harness (ticket 86c9kwnmx)
playwright-report
test-results
playwright/.cache

# Local progress file (family data; never commit real sessions)
progress.json
public/progress.json

# PWA artifacts
dev-dist

# Pre-baked session canon (ticket 86c9kwhbc — D)
# Canon JSONs are committed so Vercel builds don't re-bake on every deploy
# (the script's skip-if-exists logic short-circuits before any API call).
# Re-generate locally with `npm run canon:regen` only when prompts or
# curriculum change, then commit the diff alongside the change.

# Picture-pack reference assets (Phase 2 Midjourney PNGs)
# These are trace-references only — Phase 3 SVGs go in
# `public/assets/pictures/` instead. The PNGs are large (~3.9 MB combined)
# and have no runtime use; keep them out of the bundle.
design/references/picture-pack/**/*.png

# Security: env files with credentials must never be tracked.
# Covers .env.local, .env.production.local, .env.dev.local, etc.
.env*.local

# Runtime / scratch dirs — stop these polluting `git status`
# pair-review snap output (snap.mjs + PNGs + svg/transparent subdirs)
.tmp-pair-review/
# Vercel CLI scratch (project config, cache)
.vercel/
# generic scratch (e.g. tmp/short-u-validate/ from canon work)
tmp/
# orphaned harness convention; canonical .claude/ lives at parent MARIAN-TUTOR/ level per CLAUDE.md
.claude/
