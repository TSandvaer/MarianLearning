{
  "expo": {
    "name": "Emma's Path",
    "slug": "marian-tutor",
    "scheme": "mariantutor",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/app/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF5F0",
    "ios": {
      "bundleIdentifier": "dk.sandvaer.emmaspath",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dk.sandvaer.emmaspath"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF5F0"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3ed1920d-bab2-4fef-ab11-6413a74d5e62"
      }
    },
    "owner": "sandvaer"
  }
}
