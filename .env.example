# Marian Tutor — example environment file.
# Copy to .env.local and fill in. NEVER commit .env.local.

# URL of the Vercel Function that proxies requests to the Anthropic API.
# The Anthropic API key lives ONLY in the function's server-side env vars.
# It must never be exposed to the browser bundle.
VITE_CLAUDE_API_ENDPOINT=/api/claude
